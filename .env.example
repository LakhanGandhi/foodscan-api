# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
DB_NAME=foodcheck

# JWT (generate long random strings for both - they must be different from each other)
JWT_ACCESS_SECRET=<random string>
JWT_REFRESH_SECRET=<random string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://foodcheck-admin.onrender.com,https://foodcheck.example.com

# Scan geolocation hashing salt (carried over from the prototype)
IP_HASH_SALT=<any random string>
